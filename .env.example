# Copy to .env and replace every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# On a server: chmod 600 .env

# Postgres superuser. Used only by the db container to create the roles below.
POSTGRES_PASSWORD=change-me-superuser

# medvora_owner owns the schema and runs migrations (migrate and tools containers only).
DB_OWNER_PASSWORD=change-me-owner
# medvora_app is what the API and worker log in as. It owns nothing and cannot bypass RLS.
DB_APP_PASSWORD=change-me-app

# Server-side secret mixed into API key hashes. Changing it invalidates every key.
API_KEY_PEPPER=change-me-pepper

# Only for running tests or tools on the host against the local container.
DB_HOST=127.0.0.1
DB_PORT=5432

# AWS demo only: the subdomain pointed at the server's Elastic IP.
DOMAIN=medvora.example.com

# Optional. Each is passed into the containers when uncommented; the app's default
# (shown) applies otherwise. Local Docker raises the two rate limits to 600 and 200.
# LOG_LEVEL=INFO
# UPLOAD_MAX_BYTES=20971520
# UPLOAD_MAX_ROWS=100000
# RATE_LIMIT_RECORDS_PER_MINUTE=100
# RATE_LIMIT_UPLOADS_PER_HOUR=10

# Optional LLM match verifier, off by default (MATCH_VERIFIER=rule). It receives only
# comparison facts (agree, disagree, missing per field), never patient data, can only
# veto a match, and only the model named here is called.
# MATCH_VERIFIER=llm
# MATCH_VERIFIER_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
